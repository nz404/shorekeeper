# Salin file ini menjadi .env, lalu isi nilai sesuai server Anda.
# Jangan commit file .env dan jangan gunakan nilai contoh ini sebagai kredensial.

# Telegram — wajib untuk menjalankan bot.
TELEGRAM_TOKEN=isi_token_bot_telegram
MY_CHAT_ID=isi_telegram_user_id_admin
ADMIN_NAME=Nama_Admin

# Opsional: ID user admin tambahan / chat tujuan alert, pisahkan dengan koma.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ALERT_CHAT_IDS=

# Opsional, hanya untuk migrasi daftar user lama dari konfigurasi environment.
# Pengaturan user yang berlaku dikelola melalui database.
# TELEGRAM_ALLOWED_USER_IDS=

# Database — wajib; sesuaikan dengan database dan user yang sudah dibuat.
DB_HOST=localhost
DB_PORT=3306
DB_USER=shorekeeper
DB_PASSWORD=ganti_dengan_password_database
DB_NAME=shorekeeper_db

# AI — opsional jika sudah dikonfigurasi melalui menu admin Telegram.
# Jika belum ada konfigurasi di database, nilai ini menjadi konfigurasi awal/fallback.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
# Isi hanya untuk provider OpenAI-compatible atau endpoint kustom.
AI_BASE_URL=

# Dashboard web.
WEB_PORT=3000
WEB_ADMIN_USER=admin
WEB_PASSWORD=ganti_dengan_password_unik_minimal_8_karakter
# Setel ke true hanya jika aplikasi berada di belakang reverse proxy tepercaya.
WEB_TRUST_PROXY=

# Teks-ke-ucapan ElevenLabs (opsional).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Ambang monitor dan interval polling (opsional; nilai di bawah adalah default).
MONITOR_CPU_THRESHOLD=80
MONITOR_RAM_THRESHOLD=85
MONITOR_DISK_THRESHOLD=90
MONITOR_INTERVAL_MS=300000

# Batas waktu sesi/perintah SSH dalam milidetik (opsional).
SSH_SESSION_TIMEOUT_MS=300000
SSH_CMD_TIMEOUT_MS=30000
SSH_LONG_TIMEOUT_MS=600000

# Timeout API MikroTik dalam milidetik (opsional).
MT_API_PORT=8728
MT_API_TIMEOUT=10000

# Zona waktu untuk jadwal dan laporan.
TIMEZONE=Asia/Jakarta
